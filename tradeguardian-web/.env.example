# WalletConnect (Reown) project ID, required by RainbowKit. Get one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# EscrowFactory contract on Monad Mainnet, printed by tradeguardian-contracts/scripts/deploy-monad.js.
# Needed to create trades; the rest of the site works without it.
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=

# tradeguardian-backend on Cloud Run, which stores trades. Called from the
# browser, so the backend's CORS_ORIGINS must include this site. No trailing slash.
NEXT_PUBLIC_BACKEND_URL=
