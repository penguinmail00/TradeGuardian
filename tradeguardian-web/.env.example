# WalletConnect (Reown) project ID, required by RainbowKit. Get one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# EscrowFactory contract on Monad Testnet, printed by tradeguardian-contracts/scripts/deploy-monad-testnet.js.
# Needed to create trades; the rest of the site works without it.
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=
